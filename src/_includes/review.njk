---
layout: base.njk
---

<section class="review-head">
  <div class="container">
    <div class="meta-row">
      <span>Review</span>
      <span>·</span>
      {# Show the author's name instead of the genre #}
      <span>{{ author }}</span>
      <span>·</span>
      <time>{{ date | date }}</time>
    </div>
    <h1>{{ title }}</h1>
  </div>
</section>

<section class="review-body">
  <div class="container review-grid">

    {# Sidebar wrapper keeps the cover AND tags together when sticky #}
    <aside class="review-sidebar">
      
      <div class="cover {{ cover_class }}">
        {% if cover_image %}
        <img src="{{ cover_image | coverUrl(baseUrl) }}" alt="{{ title }}" class="cover-image">
        {% else %}
        <span class="cover-label">{{ title }}</span>
        {% endif %}
      </div>

      {# Genre and Platform under the cover #}
      <div class="review-meta-tags">
        {% if meta %}
          <div class="meta-tag">
            <span class="meta-label">Genre:</span> {{ meta | join(", ") }}
          </div>
        {% endif %}
        {% if platform %}
          <div class="meta-tag">
            <span class="meta-label">Platform:</span> {{ platform | join(", ") }}
          </div>
        {% endif %}
      </div>

    </aside>

    <div class="article-text">

      {{ content | safe }}

      {% if pros or cons %}
      <h2>Pros and Cons</h2>
      <div class="pros-cons">
        <div class="box pros">
          <h4>Positives</h4>
          <ul>
            {% for p in pros %}<li>{{ p }}</li>{% endfor %}
          </ul>
        </div>
        <div class="box cons">
          <h4>Negatives</h4>
          <ul>
            {% for c in cons %}<li>{{ c }}</li>{% endfor %}
          </ul>
        </div>
      </div>
      {% endif %}

      {% if cta %}
      <div class="cta-question">
        <p>{{ cta }}</p>
      </div>
      {% endif %}

    </div>

  </div>
</section>