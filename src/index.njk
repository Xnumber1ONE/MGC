---
layout: base.njk
title: "Moroccan Gaming Culture"
description: "News and Reviews of latest games."
permalink: "/index.html"
---

{% set allReviews = collections.reviews | reverse %}
{% set hero = allReviews[0] %}
{% set allNews = collections.news | reverse %}
{% set allArticles = collections.articles | reverse %}
<section class="hero">
  <div class="container">
    <div class="cover {{ hero.data.cover_class }}">
      {% if hero.data.cover_image %}
        <img src="{{ hero.data.cover_image | coverUrl(baseUrl) }}" alt="{{ hero.data.title }}" class="cover-image">
        {% else %}
          <span class="cover-label">{{ hero.data.title }}</span>
        {% endif %}
      </div>
      <div>
        <p class="hero-kicker">Special Review</p>
        <h1>{{ hero.data.title }}</h1>
        <p class="excerpt">{{ hero.data.excerpt }}</p>
        <a href="{{ baseUrl }}{{ hero.url }}" class="btn">Read the full review</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Latest reviews</h2>
        <a href="{{ baseUrl }}/reviews.html">See more</a>
      </div>
      <div class="content-carousel">
        <button class="genre-arrow carousel-arrow-left" type="button" aria-label="Scroll reviews left">&#10094;</button>
        <div class="carousel-container">
          <div class="carousel-track">
            {% for review in allReviews.slice(1, 6) %}
              <a class="card" href="{{ baseUrl }}{{ review.url }}">
                <div class="cover {{ review.data.cover_class }}">
                  {% if review.data.cover_image %}
                    <img src="{{ review.data.cover_image | coverUrl(baseUrl) }} " alt="{{ review.data.title }}" class="cover-image">
                    {% else %}
                      <span class="cover-label">{{ review.data.title }}</span>
                    {% endif %}
                  </div>
                  <h3>{{ review.data.title }}</h3>
                </a>
              {% endfor %}
            </div>
          </div>
          <button class="genre-arrow carousel-arrow-right" type="button" aria-label="Scroll reviews right">&#10095;</button>
        </div>
      </section>
      <section class="section">
        <div class="container">
          <div class="section-head">
            <h2>Latest news</h2>
            <a href="{{ baseUrl }}/news.html">See more</a>
          </div>
          <div class="content-carousel">
            <button class="genre-arrow carousel-arrow-left" type="button" aria-label="Scroll news left">&#10094;</button>
            <div class="carousel-container">
              <div class="carousel-track">
                {% if allNews.length > 0 %}
                  {% for item in allNews.slice(0, 5) %}
                    <a class="news-row" href="{{ baseUrl }}{{ item.url }}">
                      <time>{{ item.data.date | date }}</time>
                      <div>
                        <h3>{{ item.data.title }}</h3>
                        <p>{{ item.data.excerpt }}</p>
                      </div>
                    </a>
                  {% endfor %}
                {% else %}
                  <p style="color:var(--text-muted);">No news published yet.</p>
                {% endif %}
              </div>
            </div>
            <button class="genre-arrow carousel-arrow-right" type="button" aria-label="Scroll news right">&#10095;</button>
          </div>
        </div>
      </section>
      <section class="section">
        <div class="container">
          <div class="section-head">
            <h2>Latest articles</h2>
            <a href="{{ baseUrl }}/articles.html">See more</a>
          </div>
          <div class="content-carousel">
            <button class="genre-arrow carousel-arrow-left" type="button" aria-label="Scroll news left">&#10094;</button>
            <div class="carousel-container">
              <div class="carousel-track">
                {% if allArticles.length > 0 %}
                  {% for item in allArticles.slice(0, 5) %}
                    <a class="news-row" href="{{ baseUrl }}{{ item.url }}">
                      <time>{{ item.data.date | date }}</time>
                      <div>
                        <h3>{{ item.data.title }}</h3>
                        <p>{{ item.data.excerpt }}</p>
                      </div>
                    </a>
                  {% endfor %}
                {% else %}
                  <p style="color:var(--text-muted);">No articles published yet.</p>
                {% endif %}
              </div>
            </div>
            <button class="genre-arrow carousel-arrow-right" type="button" aria-label="Scroll news right">&#10095;</button>
          </div>
        </div>
      </section>